# DART OpenAPI 인증키 (필수) — https://opendart.fss.or.kr 회원가입 후 발급
DART_API_KEY=여기에_발급받은_인증키

# 대상 기업의 DART 고유번호 8자리 (필수). 쉼표로 여러 기업 지정 가능
# 조회: python3 dart_insider_report.py --resolve "삼성전자"
# 예시는 삼성전자(00126380)
CORP_CODE=00126380

# Slack 전송 설정 — 아래 둘 중 하나만 설정하면 됩니다.
# (1) 봇 토큰 방식: chat:write 권한이 있는 봇 토큰
SLACK_BOT_TOKEN=xoxb-...
# 전송 대상. 기본값은 본인 DM(U0AQ01K6GCB). 채널로 보내려면 채널 ID 입력
SLACK_CHANNEL=U0AQ01K6GCB

# (2) Incoming Webhook 방식 (봇 토큰 대신 사용 가능)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 조회 기준일 (선택). 미설정 시 KST 기준 전일로 자동 계산
# REPORT_DATE=20260621
